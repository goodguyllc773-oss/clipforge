# Copy this file to `.env` (same folder, repo root) and fill in the values you
# have. `.env` is gitignored — never commit real credentials. Restart the dev
# servers after changing it (the backend reads this once, at startup).
#
# Nothing here is required to use ClipForge's core clipping pipeline — only
# for connecting YouTube/TikTok publishing (README "Connecting YouTube/TikTok").

CLIPFORGE_YOUTUBE_CLIENT_ID=
CLIPFORGE_YOUTUBE_CLIENT_SECRET=

CLIPFORGE_TIKTOK_CLIENT_KEY=
CLIPFORGE_TIKTOK_CLIENT_SECRET=

# Only change this if ClipForge isn't running on the default
# http://127.0.0.1:8765 — it must match the redirect URI you register with
# each platform.
# CLIPFORGE_OAUTH_REDIRECT_BASE=http://127.0.0.1:8765
